<schemalist>
  <schema id="org.gnome.shell.extensions.charcoal-controls" path="/org/gnome/shell/extensions/charcoal-controls/">
    <key name="shortcut" type="as"><default>[]</default></key>
    <key name="wheel-items" type="as"><default>['lock', 'note', 'settings', 'themes', 'suspend', 'logout', 'restart', 'poweroff']</default></key>
    <key name="radius" type="i"><range min="100" max="320"/><default>170</default></key>
    <key name="neutral-radius" type="i"><range min="20" max="80"/><default>42</default></key>
    <key name="text-size" type="i"><range min="10" max="32"/><default>15</default></key>
    <key name="background-color" type="s"><default>'#202127'</default></key>
    <key name="foreground-color" type="s"><default>'#f0f0f2'</default></key>
    <key name="accent-color" type="s"><default>'#a6b5cc'</default></key>
    <key name="border-color" type="s"><default>'#ffffff'</default></key>
    <key name="border-width" type="i"><range min="0" max="6"/><default>1</default></key>
    <key name="shadow-color" type="s"><default>'#000000'</default></key>
    <key name="shadow-size" type="i"><range min="0" max="60"/><default>28</default></key>
    <key name="follow-theme" type="b"><default>false</default></key>
    <key name="override-activations" type="s"><default>'{}'</default></key>
    <key name="status" type="s"><default>''</default></key>
  </schema>
</schemalist>
