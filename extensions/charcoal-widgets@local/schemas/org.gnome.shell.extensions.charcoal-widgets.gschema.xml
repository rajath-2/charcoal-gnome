    <key name="shadow-opacity" type="i"><range min="0" max="100"/><default>25</default></key>
    <key name="corner-radius" type="i"><range min="0" max="40"/><default>18</default></key>
    <key name="accent-color" type="s"><default>'#f0a24a'</default></key>
    <key name="text-color" type="s"><default>'#f2ece4'</default></key>
    <key name="blur" type="b"><default>true</default></key>
