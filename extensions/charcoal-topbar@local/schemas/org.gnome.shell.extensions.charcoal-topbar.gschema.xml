<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.charcoal-topbar" path="/org/gnome/shell/extensions/charcoal-topbar/">
    <key name="mode" type="s">
      <choices><choice value="auto"/><choice value="compact"/><choice value="islands"/></choices>
      <default>'auto'</default>
      <summary>Bar layout</summary>
    </key>
    <key name="invert-auto" type="b">
      <default>false</default>
      <summary>Automatic layout swapped: islands on the desktop, full bar while an app is maximized</summary>
    </key>
    <key name="static-blur" type="b">
      <default>true</default>
      <summary>Blur only the wallpaper behind the bar and popups (cheaper than live blur)</summary>
    </key>
    <!-- Appearance: read by theme.js (stylesheet) and morph.js (auto-mode surface). -->
    <key name="bar-color" type="s"><default>'#121212'</default></key>
    <key name="bar-opacity" type="i"><range min="0" max="100"/><default>78</default></key>
    <key name="islands-opacity" type="i"><range min="0" max="100"/><default>90</default></key>
    <key name="border-opacity" type="i"><range min="0" max="60"/><default>15</default></key>
    <key name="text-color" type="s"><default>'#ededed'</default></key>
    <key name="accent-color" type="s"><default>'#c7c7c7'</default></key>
    <key name="bar-height" type="i"><range min="22" max="48"/><default>30</default></key>
    <key name="corner-radius" type="i"><range min="0" max="20"/><default>10</default></key>
    <key name="top-margin" type="i"><range min="0" max="16"/><default>3</default></key>
    <key name="side-margin" type="i"><range min="0" max="400"/><default>72</default></key>
    <key name="island-margin" type="i"><range min="0" max="120"/><default>18</default></key>
    <key name="bold-text" type="b"><default>true</default></key>
    <key name="shadow" type="b"><default>true</default></key>
    <key name="border-color" type="s"><default>'#ededed'</default></key>
    <key name="border-width" type="i"><range min="0" max="4"/><default>1</default></key>
    <key name="shadow-color" type="s"><default>'#000000'</default></key>
    <key name="shadow-size" type="i"><range min="0" max="40"/><default>12</default></key>
    <key name="shadow-opacity" type="i"><range min="0" max="100"/><default>22</default></key>
    <key name="text-size" type="i"><range min="70" max="150"/><default>100</default><summary>Bar text size, percent</summary></key>
    <key name="popup-text-color" type="s"><default>'#ededed'</default></key>
    <key name="popup-border-color" type="s"><default>'#ededed'</default></key>
    <key name="popup-border-width" type="i"><range min="0" max="4"/><default>1</default></key>
    <key name="popup-border-opacity" type="i"><range min="0" max="60"/><default>13</default></key>
    <key name="popup-shadow-color" type="s"><default>'#000000'</default></key>
    <key name="popup-shadow-size" type="i"><range min="0" max="60"/><default>24</default></key>
    <key name="popup-shadow-opacity" type="i"><range min="0" max="100"/><default>28</default></key>
    <key name="popup-color" type="s"><default>'#141414'</default></key>
    <key name="popup-opacity" type="i"><range min="30" max="100"/><default>86</default></key>
    <key name="popup-radius" type="i"><range min="0" max="32"/><default>22</default></key>
    <key name="follow-theme" type="b"><default>false</default></key>
    <key name="override-activations" type="s"><default>'{}'</default></key>
  </schema>
</schemalist>
